# =====================================================================
# فایل htaccess ریشه برای سناریوی B:
# زمانی که کل برنامه (خروجی cpanel-app.zip) مستقیماً داخل public_html
# استخراج شده باشد و امکان تغییر DocumentRoot وجود نداشته باشد.
#
# این محتوا را جایگزین فایل public_html/.htaccess کنید.
# (این فایل با پسوند .txt قرار داده شده تا توسط آپاچی اجرا نشود)
# =====================================================================

<Files ".env">
    Require all denied
</Files>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # تمام درخواست‌ها به پوشه public/ لاراول هدایت می‌شوند
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
